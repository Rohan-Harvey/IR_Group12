<?xml version='1.0' encoding='utf-8'?>
<robot name="parking_robot">
  <link name="base_footprint" />
  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <box size="4.5 1.84 0.25" />
      </geometry>
      <material name="base_link_material">
        <color rgba="0.08 0.31 0.68 1" />
      </material>
    </visual>
  </link>
  <joint name="base_fixed" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0.0 0.0 0.36" rpy="0 0 0" />
  </joint>
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.32" length="0.18" />
      </geometry>
      <material name="front_left_wheel_material">
        <color rgba="0.035 0.04 0.045 1" />
      </material>
    </visual>
  </link>
  <link name="front_left_knuckle" />
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link" />
    <child link="front_left_knuckle" />
    <origin xyz="1.375 0.79 -0.03999999999999998" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.65" upper="0.65" effort="1500" velocity="1.5" />
  </joint>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_knuckle" />
    <child link="front_left_wheel" />
    <origin xyz="0.0 0.0 0.0" rpy="-1.5707963267948966 0 0" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.32" length="0.18" />
      </geometry>
      <material name="front_right_wheel_material">
        <color rgba="0.035 0.04 0.045 1" />
      </material>
    </visual>
  </link>
  <link name="front_right_knuckle" />
  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link" />
    <child link="front_right_knuckle" />
    <origin xyz="1.375 -0.79 -0.03999999999999998" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.65" upper="0.65" effort="1500" velocity="1.5" />
  </joint>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_knuckle" />
    <child link="front_right_wheel" />
    <origin xyz="0.0 0.0 0.0" rpy="-1.5707963267948966 0 0" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.32" length="0.18" />
      </geometry>
      <material name="rear_left_wheel_material">
        <color rgba="0.035 0.04 0.045 1" />
      </material>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_left_wheel" />
    <origin xyz="-1.375 0.79 -0.03999999999999998" rpy="-1.5707963267948966 0 0" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.32" length="0.18" />
      </geometry>
      <material name="rear_right_wheel_material">
        <color rgba="0.035 0.04 0.045 1" />
      </material>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_right_wheel" />
    <origin xyz="-1.375 -0.79 -0.03999999999999998" rpy="-1.5707963267948966 0 0" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="lidar_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.09" length="0.07" />
      </geometry>
      <material name="lidar_link_material">
        <color rgba="0.12 0.14 0.16 1" />
      </material>
    </visual>
  </link>
  <joint name="lidar_link_fixed" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.0 0.0 0.4" rpy="0 0 0" />
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.12 0.08" />
      </geometry>
      <material name="camera_link_material">
        <color rgba="0.12 0.14 0.16 1" />
      </material>
    </visual>
  </link>
  <joint name="camera_link_fixed" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="2.25 0.0 0.2" rpy="0 0 0" />
  </joint>
  <link name="imu_link" />
  <joint name="imu_link_fixed" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0.0 0.0 0.02" rpy="0 0 0" />
  </joint>
  <link name="camera_optical_frame" />
  <joint name="camera_optical_fixed" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
    <origin xyz="0.07 0.0 0.0" rpy="-1.5707963267948966 0 -1.5707963267948966" />
  </joint>
</robot>